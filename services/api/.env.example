# Copy to .env for local development. Tests ignore this file and set their own values.
# Secrets have no defaults in app/config.py: a missing value fails at start-up.
STACKD_ENV=dev
STACKD_DATABASE_URL=postgresql+psycopg://stackd:stackd@localhost:5432/stackd
STACKD_S3_ENDPOINT_URL=http://localhost:9000
STACKD_S3_REGION=us-east-1
STACKD_S3_BUCKET=stackd-backups
STACKD_S3_ACCESS_KEY=stackd
STACKD_S3_SECRET_KEY=stackd-dev-storage
STACKD_IP_HASH_KEY=stackd-dev-ip-hash-key
STACKD_TRUST_PROXY_HEADERS=false
# Production: the secret CloudFront sends as X-Origin-Verify (requests without it get 403)
# STACKD_ORIGIN_VERIFY=
STACKD_SECRET_KEY=stackd-dev-secret-key
STACKD_RP_ID=localhost
STACKD_ORIGINS=["http://localhost:5173"]
# Tester tools: emails (JSON list) that may switch their own plan for free. Keep real
# addresses out of the repository; set them in .env and the production secret only.
STACKD_ADMIN_EMAILS=[]
STACKD_COOKIE_SECURE=false
STACKD_DELETION_GRACE_DAYS=30
# Web Push: generate once with `uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode())"`
# STACKD_VAPID_PRIVATE_KEY=
# STACKD_VAPID_PUBLIC_KEY=
# STACKD_VAPID_SUBJECT=mailto:security@qash.solutions
# Native push (Phase 2): APNs needs the .p8 key, its id and the team id; Android needs the
# Firebase service-account JSON. Each platform is off until its values are set.
# STACKD_APNS_KEY=
# STACKD_APNS_KEY_ID=
# STACKD_APNS_TEAM_ID=
# STACKD_APNS_TOPIC=com.stackd.app
# STACKD_APNS_USE_SANDBOX=true
# STACKD_FCM_SERVICE_ACCOUNT=
# Native billing (Phase 2): the Play Developer API service account; Apple needs no secret
# (notifications are verified against the bundled Apple root certificate).
# STACKD_PLAY_SERVICE_ACCOUNT=
# STACKD_PLAY_PACKAGE=com.stackd.app
# The public website (apps/site); only /api/public/ answers it cross-origin
# STACKD_SITE_ORIGIN=http://localhost:4321
# Stripe (test-mode key, webhook secret and price ids; billing is off without all seven)
# STACKD_STRIPE_SECRET_KEY=sk_test_...
# STACKD_STRIPE_WEBHOOK_SECRET=whsec_...
# STACKD_STRIPE_PRICE_PRIVATE_MONTHLY=price_...
# STACKD_STRIPE_PRICE_PRIVATE_YEARLY=price_...
# STACKD_STRIPE_PRICE_CONNECTED_MONTHLY=price_...
# STACKD_STRIPE_PRICE_CONNECTED_YEARLY=price_...
# STACKD_STRIPE_PRICE_FOUNDING=price_...
# STACKD_STRIPE_PAYMENT_METHOD_CONFIG=pmc_...   # cards + US bank; optional, else the Dashboard decides
# STACKD_BILLING_OPEN=everyone   # off | admins | everyone; unset = off in prod, everyone elsewhere
STACKD_EMAIL_BACKEND=console
STACKD_EMAIL_FROM=Stackd <no-reply@localhost>
# STACKD_EMAIL_BACKEND=smtp uses these (Mailpit in docker-compose: localhost:1025, inbox at :8025)
STACKD_SMTP_HOST=localhost
STACKD_SMTP_PORT=1025

# Read-only bank and card linking (Phase 3; docs/security/linking.md). Off unless all three are
# set. The secret never goes in git or chat. Make the token key with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# STACKD_PLAID_CLIENT_ID=
# STACKD_PLAID_SECRET=
# STACKD_PLAID_ENV=sandbox
# Where Plaid posts webhooks (public https only; leave unset locally: the app syncs on open).
# STACKD_PLAID_WEBHOOK_URL=https://app.qash.solutions/api/webhooks/plaid
# STACKD_LINK_TOKEN_KEY=
