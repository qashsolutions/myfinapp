{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    "services/rules/tests/golden/**",
    "services/rules/stackd_rules/__init__.py",
    "services/api/app/rules_server/plans.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["GITHUB_SHA"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
