{
  "name": "@stackd/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed client for services/api, generated from its OpenAPI document.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
