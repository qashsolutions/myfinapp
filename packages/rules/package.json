{
  "name": "@stackd/rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of stackd_rules for the on-device engine. Must pass the identical golden tests.",
  "exports": {
    ".": "./src/index.ts",
    "./dates": "./src/dates.ts",
    "./engine": "./src/engine.ts",
    "./helped": "./src/helped.json",
    "./insights": "./src/insights.json",
    "./keywords": "./src/keywords.json",
    "./moments": "./src/moments.json",
    "./next_move": "./src/next_move.json",
    "./text": "./src/text.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
