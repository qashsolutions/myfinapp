---
/** Line icons for the pricing page (plan marks, features, terms). Decorative (aria-hidden). */
interface Props {
  name:
    | "free" | "private" | "connected"
    | "chart" | "forecast" | "file" | "jar" | "trophy" | "cloud" | "link" | "heart" | "check"
    | "dollar" | "renew" | "cancel" | "card" | "keep";
}
const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
  {name === "free" && (<g><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z" /></g>)}
  {name === "private" && (<g><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z" /><rect x="9" y="11" width="6" height="5" rx="1" /><path d="M10 11V9.5a2 2 0 0 1 4 0V11" /></g>)}
  {name === "connected" && (<g><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3A4 4 0 0 0 11 18.7l1-1" /></g>)}
  {name === "chart" && (<g><path d="M4 19h16" /><path d="M7 16V10M12 16V6M17 16v-4" /></g>)}
  {name === "forecast" && (<g><path d="M3 17l5-5 4 3 8-8" /><path d="M15 7h5v5" /><path d="M3 21h18" stroke-dasharray="2 3" /></g>)}
  {name === "file" && (<g><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></g>)}
  {name === "jar" && (<g><rect x="7" y="3" width="10" height="3" rx="1" /><path d="M6 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3z" /><path d="M6 13h12" /></g>)}
  {name === "trophy" && (<g><path d="M8 4h8v5a4 4 0 0 1-8 0z" /><path d="M16 5h3v2a3 3 0 0 1-3 3M8 5H5v2a3 3 0 0 0 3 3" /><path d="M12 13v4M9 20h6" /></g>)}
  {name === "cloud" && (<g><path d="M7 18a4.5 4.5 0 0 1-.6-9A6 6 0 0 1 18 8.5a4 4 0 0 1-.5 9.5z" /><rect x="10" y="12" width="4" height="3.5" rx=".6" /><path d="M10.8 12v-1a1.2 1.2 0 0 1 2.4 0v1" /></g>)}
  {name === "link" && (<g><path d="M3 9.5 12 4l9 5.5" /><path d="M5 10v7M9.5 10v7M14.5 10v7M19 10v7" /><path d="M3 20h18" /></g>)}
  {name === "heart" && (<g><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" /></g>)}
  {name === "check" && (<g><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.5 2.5L16 9.5" /></g>)}
  {name === "dollar" && (<g><circle cx="12" cy="12" r="9" /><path d="M12 6.5v11M14.8 9c0-1.1-1.3-2-2.8-2s-2.8.9-2.8 2 1.2 1.7 2.8 2.1 2.8 1 2.8 2.1-1.3 2-2.8 2-2.8-.9-2.8-2" /></g>)}
  {name === "renew" && (<g><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.7M20 4v4.7h-4.7" /><path d="M20 12a8 8 0 0 1-13.7 5.6L4 15.3M4 20v-4.7h4.7" /></g>)}
  {name === "cancel" && (<g><rect x="5" y="4" width="14" height="16" rx="2" /><path d="M9.5 10.5l5 5M14.5 10.5l-5 5" /></g>)}
  {name === "card" && (<g><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18M7 15h3" /></g>)}
  {name === "keep" && (<g><path d="M5 8h14l-1 11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z" /><path d="M9 8V5h6v3M10 13l1.5 1.5L14.5 11" /></g>)}
</svg>
