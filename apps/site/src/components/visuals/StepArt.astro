---
/**
 * How it works: one drawing per step (example numbers). Decorative: each step's heading and
 * line say the same thing, so every SVG is aria-hidden. Colours come from the tokens (v-*
 * classes in site.css), so the drawings follow light and dark mode.
 */
interface Props {
  kind: "bring" | "see" | "ahead" | "save";
}
const { kind } = Astro.props;
const uid = `sa-${kind}`;
---

<svg class="step-art" viewBox="0 0 400 280" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="v-stop-a1" stop-opacity="0.18" />
      <stop offset="1" class="v-stop-a3" stop-opacity="0.10" />
    </linearGradient>
    <linearGradient id={`${uid}-area`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="v-stop-a1" stop-opacity="0.28" />
      <stop offset="1" class="v-stop-a1" stop-opacity="0" />
    </linearGradient>
    <filter id={`${uid}-shadow`} x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-color="#111827" flood-opacity="0.12" />
    </filter>
  </defs>
  <circle cx="200" cy="140" r="132" fill={`url(#${uid}-glow)`} />

  {
    kind === "bring" && (
      <g>
        {/* the phone: one list, whatever the source */}
        <g filter={`url(#${uid}-shadow)`}>
          <rect x="148" y="28" width="112" height="224" rx="22" class="v-ink" />
          <rect x="154" y="34" width="100" height="212" rx="17" class="v-card" />
        </g>
        <rect x="186" y="40" width="36" height="7" rx="3.5" class="v-ink" />
        <text x="166" y="72" class="v-t v-ink" font-size="11" font-weight="700">Today</text>
        {[
          { y: 84, name: "Paycheck", amt: "+$2,400", c: "v-a2" },
          { y: 124, name: "Groceries", amt: "−$62.10", c: "v-ink" },
          { y: 164, name: "Coffee", amt: "−$4.50", c: "v-ink" },
          { y: 204, name: "Phone bill", amt: "−$45", c: "v-ink" },
        ].map((r, i) => (
          <g class="v-pop" style={`animation-delay:${0.2 + i * 0.15}s`}>
            <rect x="162" y={r.y} width="84" height="32" rx="9" class="v-bg" />
            <circle cx="176" cy={r.y + 16} r="7" class={i === 0 ? "v-a2" : i === 1 ? "v-a1" : i === 2 ? "v-warning" : "v-a3"} opacity="0.9" />
            <text x="188" y={r.y + 13} class="v-t v-ink" font-size="8.5" font-weight="600">{r.name}</text>
            <text x="188" y={r.y + 25} class={`v-t ${r.c}`} font-size="9" font-weight="700">{r.amt}</text>
          </g>
        ))}

        {/* statement */}
        <g class="v-float">
          <path d="M70 108 C 110 108, 120 120, 150 132" class="v-a1-stroke" stroke-width="2" stroke-dasharray="4 5" fill="none" />
          <rect x="22" y="58" width="64" height="80" rx="10" class="v-card" filter={`url(#${uid}-shadow)`} />
          <path d="M70 58 h16 v16 z" class="v-line" />
          <rect x="32" y="72" width="34" height="5" rx="2.5" class="v-line" />
          <rect x="32" y="84" width="44" height="5" rx="2.5" class="v-line" />
          <rect x="32" y="96" width="38" height="5" rx="2.5" class="v-line" />
          <rect x="32" y="114" width="44" height="14" rx="7" class="v-a1" />
          <text x="54" y="124" text-anchor="middle" class="v-t v-on" font-size="8" font-weight="700">CSV · PDF</text>
        </g>

        {/* receipt */}
        <g class="v-float" style="animation-delay:.6s">
          <path d="M80 210 C 115 205, 125 190, 150 182" class="v-a2-stroke" stroke-width="2" stroke-dasharray="4 5" fill="none" />
          <path d="M34 168 h48 v68 l-6 -4 -6 4 -6 -4 -6 4 -6 -4 -6 4 -6 -4 -6 4 z" class="v-card" filter={`url(#${uid}-shadow)`} />
          <rect x="42" y="180" width="26" height="4" rx="2" class="v-line" />
          <rect x="42" y="190" width="32" height="4" rx="2" class="v-line" />
          <rect x="42" y="200" width="20" height="4" rx="2" class="v-line" />
          <circle cx="82" cy="170" r="13" class="v-a2" />
          <rect x="75" y="165" width="14" height="10" rx="2.5" class="v-on-stroke" stroke-width="1.6" fill="none" />
          <circle cx="82" cy="170" r="2.6" class="v-on-stroke" stroke-width="1.6" fill="none" />
        </g>

        {/* bank link (Connected) */}
        <g class="v-float" style="animation-delay:1.2s">
          <path d="M318 150 C 290 150, 280 140, 258 140" class="v-a3-stroke" stroke-width="2" stroke-dasharray="4 5" fill="none" />
          <rect x="300" y="104" width="80" height="78" rx="16" class="v-card" filter={`url(#${uid}-shadow)`} />
          <path d="M340 116 l22 11 h-44 z" class="v-a3" />
          <rect x="322" y="130" width="6" height="22" rx="2" class="v-a3" opacity="0.8" />
          <rect x="337" y="130" width="6" height="22" rx="2" class="v-a3" opacity="0.8" />
          <rect x="352" y="130" width="6" height="22" rx="2" class="v-a3" opacity="0.8" />
          <rect x="316" y="154" width="48" height="5" rx="2.5" class="v-a3" />
          <rect x="310" y="166" width="60" height="12" rx="6" class="v-pending-bg" />
          <text x="340" y="175" text-anchor="middle" class="v-t v-a3" font-size="7.5" font-weight="700">READ-ONLY</text>
        </g>
      </g>
    )
  }

  {
    kind === "see" && (
      <g>
        <g filter={`url(#${uid}-shadow)`}>
          <rect x="40" y="34" width="320" height="212" rx="24" class="v-card" />
        </g>
        <text x="64" y="66" class="v-t v-sub" font-size="11" font-weight="600">October</text>
        <text x="64" y="94" class="v-t v-ink" font-size="26" font-weight="700">You kept $1,240</text>

        {/* donut: where it went */}
        <g transform="translate(118 170)">
          <circle r="44" class="v-line-stroke" stroke-width="16" fill="none" />
          <circle r="44" class="v-a1-stroke" stroke-width="16" fill="none" stroke-dasharray="110 277" transform="rotate(-90)" />
          <circle r="44" class="v-a2-stroke" stroke-width="16" fill="none" stroke-dasharray="70 277" stroke-dashoffset="-112" transform="rotate(-90)" />
          <circle r="44" class="v-a3-stroke" stroke-width="16" fill="none" stroke-dasharray="52 277" stroke-dashoffset="-184" transform="rotate(-90)" />
          <circle r="44" stroke="var(--c-warning)" stroke-width="16" fill="none" stroke-dasharray="36 277" stroke-dashoffset="-238" transform="rotate(-90)" />
          <text y="-2" text-anchor="middle" class="v-t v-ink" font-size="13" font-weight="700">$3,560</text>
          <text y="12" text-anchor="middle" class="v-t v-sub" font-size="8.5" font-weight="600">spent</text>
        </g>

        {/* in / out bars */}
        {[
          { y: 126, label: "In", amt: "+$4,800", w: 150, c: "v-a2" },
          { y: 166, label: "Out", amt: "−$3,560", w: 111, c: "v-a1" },
        ].map((b) => (
          <g>
            <text x="196" y={b.y} class="v-t v-sub" font-size="10" font-weight="600">{b.label}</text>
            <text x="336" y={b.y} text-anchor="end" class="v-t v-ink" font-size="10" font-weight="700">{b.amt}</text>
            <rect x="196" y={b.y + 7} width="140" height="12" rx="6" class="v-bg" />
            <rect x="196" y={b.y + 7} width={Math.min(140, b.w * 0.93)} height="12" rx="6" class={`${b.c} v-grow`} />
          </g>
        ))}
        <rect x="196" y="206" width="140" height="26" rx="13" class="v-pending-bg" />
        <circle cx="210" cy="219" r="5" class="v-a2" />
        <text x="222" y="223" class="v-t v-ink" font-size="10" font-weight="700">+$410 vs September</text>
      </g>
    )
  }

  {
    kind === "ahead" && (
      <g>
        <g filter={`url(#${uid}-shadow)`}>
          <rect x="30" y="30" width="340" height="220" rx="24" class="v-card" />
        </g>
        <text x="54" y="62" class="v-t v-sub" font-size="11" font-weight="600">Next 30 days</text>
        <text x="54" y="88" class="v-t v-ink" font-size="20" font-weight="700">Short $120 on the 22nd</text>

        {/* buffer floor */}
        <line x1="54" y1="196" x2="346" y2="196" class="v-danger-stroke" stroke-width="1.5" stroke-dasharray="5 5" opacity="0.7" />
        <text x="346" y="190" text-anchor="end" class="v-t v-sub" font-size="8.5" font-weight="600">Your buffer</text>

        {/* estimated balance */}
        <path d="M54 128 L96 140 L118 118 L160 150 L196 166 L232 204 L252 210 L262 132 L304 152 L346 164 L346 228 L54 228 Z" fill={`url(#${uid}-area)`} />
        <path d="M54 128 L96 140 L118 118 L160 150 L196 166 L232 204 L252 210 L262 132 L304 152 L346 164" class="v-a1-stroke v-draw" stroke-width="3" fill="none" stroke-linejoin="round" stroke-linecap="round" />

        {/* paydays and bills */}
        <circle cx="118" cy="118" r="5" class="v-a2" />
        <circle cx="262" cy="132" r="5" class="v-a2" />
        <circle cx="160" cy="150" r="4" class="v-warning" />
        <circle cx="232" cy="204" r="4" class="v-warning" />

        {/* lowest point */}
        <circle cx="252" cy="210" r="11" class="v-danger v-pulse" opacity="0.18" />
        <circle cx="252" cy="210" r="6" class="v-danger" />
        <rect x="186" y="226" width="132" height="16" rx="8" class="v-pending-bg" />
        <text x="252" y="237" text-anchor="middle" class="v-t v-ink" font-size="8.5" font-weight="700">Move $120 from a jar</text>
      </g>
    )
  }

  {
    kind === "save" && (
      <g>
        {[
          { x: 52, pct: 0.8, label: "Trip", note: "80%", c: "v-a2" },
          { x: 152, pct: 0.55, label: "Emergency", note: "55%", c: "v-a1" },
          { x: 252, pct: 0.32, label: "New car", note: "32%", c: "v-a3" },
        ].map((j, i) => {
          const top = 88;
          const h = 132;
          const fill = Math.round(h * j.pct);
          return (
            <g>
              <g filter={`url(#${uid}-shadow)`}>
                <rect x={j.x + 18} y={top - 14} width="60" height="12" rx="6" class={j.c} opacity="0.45" />
                <rect x={j.x} y={top} width="96" height={h} rx="26" class="v-card" />
              </g>
              <clipPath id={`${uid}-jar-${i}`}>
                <rect x={j.x + 6} y={top + 6} width="84" height={h - 12} rx="21" />
              </clipPath>
              <g clip-path={`url(#${uid}-jar-${i})`}>
                <rect x={j.x} y={top + h - fill} width="96" height={fill} class={`${j.c} v-rise`} opacity="0.85" style={`animation-delay:${0.2 + i * 0.2}s`} />
                <path d={`M${j.x} ${top + h - fill} q 24 -8 48 0 t 48 0 v 8 h -96 z`} class={j.c} opacity="0.5" />
              </g>
              <text x={j.x + 48} y={top + h - fill + 24} text-anchor="middle" class="v-t v-on" font-size="15" font-weight="700">{j.note}</text>
              <text x={j.x + 48} y={top + h + 22} text-anchor="middle" class="v-t v-ink" font-size="11" font-weight="700">{j.label}</text>
            </g>
          );
        })}
        <rect x="116" y="20" width="168" height="26" rx="13" class="v-card" filter={`url(#${uid}-shadow)`} />
        <circle cx="134" cy="33" r="6" class="v-a2" />
        <text x="146" y="37" class="v-t v-ink" font-size="10" font-weight="700">$25 a week gets you there</text>
      </g>
    )
  }
</svg>
