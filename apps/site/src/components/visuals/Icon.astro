  {name === "lock" && (<g><rect x="5" y="10.5" width="14" height="10.5" rx="2" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" /><path d="M12 15v2.5" /></g>)}
  {name === "card" && (<g><rect x="3" y="5.5" width="18" height="13" rx="2" /><path d="M3 10h18" /><path d="M3 3l18 18" /></g>)}
  {name === "cancel" && (<g><circle cx="12" cy="12" r="8.5" /><path d="m9 9 6 6M15 9l-6 6" /></g>)}
  {name === "switch" && (<g><path d="M4 8h14l-3-3" /><path d="M20 16H6l3 3" /></g>)}
  {name === "refund" && (<g><path d="M4 12a8 8 0 1 0 2.3-5.6" /><path d="M4 4v4h4" /><path d="M12 8v8M9.5 10.5h4a1.5 1.5 0 0 1 0 3h-3a1.5 1.5 0 0 0 0 3h4" /></g>)}
  {name === "export" && (<g><path d="M12 3v12" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></g>)}
