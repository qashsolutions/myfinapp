  {name === "jar" && (<g><rect x="7" y="3" width="10" height="3" rx="1" /><path d="M6 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3z" /><path d="M6 13h12" /></g>)}
