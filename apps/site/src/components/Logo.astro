---
/**
 * The Qash mark, "Rising Q" (owner, October 16, 2026): a white Q on an indigo tile with three
 * marigold bars rising inside it. Brand colours, the same in light and dark mode. The app
 * (apps/web/src/app/layout/Logo.tsx), its icons and the favicons still draw the earlier
 * five-bar mark until they are switched in their own change.
 */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
const INDIGO = "#4338FF";
const MARIGOLD = "#FFB020";
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect width="100" height="100" rx="22" fill={INDIGO} />
  <g transform="translate(10 10) scale(0.8)">
    <circle cx="46" cy="46" r="28" fill="none" stroke="#FFFFFF" stroke-width="10" />
    <rect x="27" y="42" width="6" height="8" rx="2" fill={MARIGOLD} />
    <rect x="35.5" y="37" width="6" height="13" rx="2" fill={MARIGOLD} />
    <rect x="44" y="32" width="6" height="18" rx="2" fill={MARIGOLD} />
    <line x1="56" y1="56" x2="78" y2="78" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round" />
  </g>
</svg>
